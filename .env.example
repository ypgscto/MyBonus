APP_NAME=BONUSKU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/bonusku/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bonusku
DB_USERNAME=root
DB_PASSWORD=123456

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production behind HTTPS
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=stikes.gs@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="stikes.gs@gmail.com"
MAIL_FROM_NAME="BONUSKU STIKES Gunung Sari"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Bonusku Mobile API (Flutter)
# ---------------------------------------------------------------------------
# API_BASE_URL: public URL for mobile clients (defaults to APP_URL)
# API_TOKEN_EXPIRATION: token lifetime in minutes; leave empty for no expiry (local dev)
# API_RATE_LIMIT_LOGIN: max login attempts per minute per IP+email
# API_RATE_LIMIT_AUTH: max authenticated requests per minute per user
# API_PER_PAGE: default pagination size
# API_MAX_PER_PAGE: maximum allowed per_page query param
API_PREFIX=api
API_VERSION=v1
API_BASE_URL="${APP_URL}"
API_TOKEN_EXPIRATION=
API_DEFAULT_DEVICE_NAME=mobile
API_TOKEN_ABILITIES=mobile-access
API_RATE_LIMIT_LOGIN=10
API_RATE_LIMIT_AUTH=120
API_PER_PAGE=15
API_MAX_PER_PAGE=100

# Firebase Cloud Messaging (push notification mobile)
# Kosongkan di local — push akan disimulasikan (in-app notification tetap tersimpan)
FCM_SERVER_KEY=
FCM_API_URL=https://fcm.googleapis.com/fcm/send

KIRIMI_USER_CODE=
KIRIMI_SECRET=
KIRIMI_DEVICE_ID=
KIRIMI_API_URL=https://api.kirimi.id/v1/send-message
