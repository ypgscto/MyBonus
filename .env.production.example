# Copy to .env on production server (or use scripts/install-production.bat)
APP_NAME=BONUSKU
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://bonusku.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=bonusku
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when APP_URL uses https://
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="stikes.gs@gmail.com"
MAIL_FROM_NAME="BONUSKU STIKES Gunung Sari"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MyBonus Mobile API (Flutter) — production
# ---------------------------------------------------------------------------
API_PREFIX=api
API_VERSION=v1
# Must match public URL (no trailing slash). Mobile: API_BASE_URL/api/v1
API_BASE_URL="${APP_URL}"
# Token expiry: 10080 = 7 days. Leave empty only for local dev.
API_TOKEN_EXPIRATION=10080
API_DEFAULT_DEVICE_NAME=mobile
API_TOKEN_ABILITIES=mobile-access
API_RATE_LIMIT_LOGIN=10
API_RATE_LIMIT_AUTH=120
API_PER_PAGE=15
API_MAX_PER_PAGE=100

# Firebase Cloud Messaging (optional — in-app notifications work without FCM)
FCM_SERVER_KEY=
FCM_API_URL=https://fcm.googleapis.com/fcm/send

KIRIMI_USER_CODE=
KIRIMI_SECRET=
KIRIMI_DEVICE_ID=
KIRIMI_API_URL=https://api.kirimi.id/v1/send-message
